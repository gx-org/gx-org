package main

func applyTwice(f func([3]float32) [3]float32, x [3]float32) [3]float32 {
	return f(f(x))
}

func double(x [3]float32) [3]float32 {
	return 2 * x
}

func Main() ([3]float32, [3]float32) {
	x := [3]float32{1, 2, 3}
	square := func(x [3]float32) [3]float32 {
		return x * x
	}
	return applyTwice(double, x), applyTwice(square, x)
}
