package main

func Main() ([3]float32, float32, []int, [3]float32, [2][3]float32) {
	a := [...]float32{
		{1, 2, 3},
		{4, 5, 6},
	}
	// Replace the element at index 1 of v with 42.
	v := [3]float32{1, 2, 3}
	v = set(v, float32(42), 1)
	// Replace the first row of m with v.
	m := [2][3]float32{}
	m = set(m, v, 0)
	return a[1], a[1][2], axlengths(a), v, m
}
