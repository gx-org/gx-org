package main

type floats interface {
	float32 | float64
}

type Polygon[N int, T floats] struct {
	X, Y [N]T
}

func Main() (Polygon[3, float32], Polygon[4, float64]) {
	triangle := Polygon[3, float32]{
		X: [3]float32{0, 1, 0},
		Y: [3]float32{0, 0, 1},
	}
	square := Polygon[4, float64]{
		X: [4]float64{0, 1, 1, 0},
		Y: [4]float64{0, 0, 1, 1},
	}
	return triangle, square
}
