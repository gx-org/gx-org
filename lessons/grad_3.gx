package main

import (
    "math/grad"
    "reflect"
)

type Params struct {
    W float32
    B float32
}

func loss(p Params) float32 {
    err := 2*p.W + p.B - 1
    return err * err
}

func Main() Params {
    p := Params{W: 1, B: 1}
    _, backward := grad.Reverse(loss)(p)
    g := backward(1)
    for _, k := range reflect.Leaves[Params]() {
        p[k] -= 0.1 * g[k]
    }
    return p
}
