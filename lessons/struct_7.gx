package main

import "math/grad"

type Params struct {
	W float32
	B float32
}

func (p Params) Predict(x float32) float32 {
	return p.W*x + p.B
}

func loss(p Params) float32 {
	err := 2*p.W + p.B - 1
	return err * err
}

func Main() (Params, Params, float32) {
	p := Params{W: 1, B: 1}
	_, backward := grad.Reverse(loss)(p)
	g := backward(1)
	p.W -= 0.1 * g.W
	p.B -= 0.1 * g.B
	_, backP, backX := grad.Reverse(p.Predict)(2)
	return p, backP(1), backX(1)
}
