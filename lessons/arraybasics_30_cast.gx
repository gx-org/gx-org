package main

func Main() ([2][2]float32, [2][3]int32, [1][3][2]float32, [2][2]float32) {
	// Create a [2][2] array filled with zeros.
	zeros := [2][2]float32{}
	a := [2][3]float32{
		{1, 2, 3},
		{4, 5, 6},
	}
	// Reshape a to [1][3][2], keeping the order of its 6 elements.
	aReshaped := [1][3][2]float32(a)
	// Convert the elements of a to int32, keeping its axis lengths.
	aInt32 := [...]int32(a)
	// Cast the scalar 5 to a [2][2] array.
	fives := [2][2]float32(5)
	return zeros, aInt32, aReshaped, fives
}
