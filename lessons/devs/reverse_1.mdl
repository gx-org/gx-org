
```code:main
package main

import "math"
import "math/grad"

func sigmoid(x float32) float32 {
    result := 1 / (1 + math.Exp(-x))
    result = result + 2
    return result
}


func Main() (float32, float32) {
    vjpSig := grad.VJP(sigmoid) // Macro computed by the compiler
    y, gradY := vjpSig(0.0) // Returns sigmoid(0.0) and a gradient function at 0.0
    return y, gradY(1.0)
}
```

