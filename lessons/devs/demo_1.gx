package main

import "shape"
import "num"
import "math"

var QKVDim int

func rope(x [QKVDim]float32, pos float32) [QKVDim]float32 {
	maxWavelength := [QKVDim / 2]float32(10000)
	maxIota := 2 / float32(QKVDim)
	freqExp := [...]float32(num.IotaFull[[]int{QKVDim / 2}, int64]()) * maxIota
	timescale := math.Pow(maxWavelength, freqExp)
	radians := pos / timescale
	sin, cos := math.Sin(radians), math.Cos(radians)
	xx := shape.Split[0][2](x)
	return shape.Concat[0](
		xx[0]*cos-xx[1]*sin,
		xx[1]*cos+xx[0]*sin,
	).([QKVDim]float32)
}
