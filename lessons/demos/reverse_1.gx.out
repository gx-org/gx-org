float32(0.5)
float32(0.25)
func(x float32) (float32, func(res float32) float32) {
	fwd0 := -x
	fwd1, ExpVJP := grad.Reverse(math.Exp)(fwd0)
	fwd2 := 1+fwd1
	fwd3 := 1/fwd2
	selfVJPFunc := func(res float32) float32 {
		bck3y := -res/(fwd2*fwd2)
		bck1 := ExpVJP(bck3y)
		bck0 := -bck1
		return bck0
	}
	return fwd3, selfVJPFunc
}
