
```code:main
package main

import (
    "math"
    "math/grad"
)

func sigmoid(x float32) float32 {
    return 1 / (1 + math.Exp(-x))
}

func Main() (float32, float32) {
    // Macro computed by the compiler.
    vjpSig := grad.VJP(sigmoid) 
    // Trace the function at runtime to print it in the output.
    trace(vjpSig)  
    // Compute sigmoid(0.0) and a gradient function at 0.0.
    y, gradY := vjpSig(0.0) 
    // Return the value and its gradient.
    return y, gradY(1.0)
}
```

