package main

import (
	"math/grad"
	"reflect"
)

type Linear struct {
	W float32
	B float32
}

func loss(l Linear) float32 {
	err := 2*l.W + l.B - 1
	return err * err
}

func sgd(params, grads Linear, lr float32) Linear {
	for _, k := range reflect.Leaves[Linear]() {
		params[k] -= lr * grads[k]
	}
	return params
}

func Main() Linear {
	l := Linear{W: 1, B: 1}
	_, backward := grad.Reverse(loss)(l)
	g := backward(1)
	return sgd(l, g, 0.01)
}
