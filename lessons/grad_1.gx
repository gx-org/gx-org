package main

import "math/grad"

func square(x float32) float32 {
	return x * x
}

func linear(w, x, b float32) float32 {
	return w*x + b
}

func Main() (float32, float32, float32, float32, float32) {
	vjp := grad.Reverse(square)
	// Trace vjp to output its implementation.
	trace(vjp)
	y, backward := vjp(3)
	_, backW, backX, backB := grad.Reverse(linear)(2, 5, 1)
	return y, backward(1), backW(1), backX(1), backB(1)
}
