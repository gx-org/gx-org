package main

import (
	"math/grad"
	"num"
)

func square(x float32) float32 {
	return x * x
}

func dot(w, x [3]float32) float32 {
	return num.VecMul(w, x)
}

func Main() (float32, float32, [3]float32, [3]float32) {
	vjp := grad.Reverse(square)
	// Trace vjp to output its implementation.
	trace(vjp)
	y, backward := vjp(3)
	w := [3]float32{1, 2, 3}
	x := [3]float32{4, 5, 6}
	_, backW, backX := grad.Reverse(dot)(w, x)
	return y, backward(1), backW(1), backX(1)
}
