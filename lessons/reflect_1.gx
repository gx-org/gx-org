package main

import "reflect"

type Layer struct {
	W [2][3]float32
	B [3]float32
}

type Params struct {
	Hidden Layer
	Scale  float32
}

func Main() Params {
	p := Params{
		Hidden: Layer{
			W: [2][3]float32{{1, 2, 3}, {4, 5, 6}},
			B: [3]float32{7, 8, 9},
		},
		Scale: 1,
	}
	for _, k := range reflect.Leaves[Params]() {
		p[k] *= 2
	}
	return p
}
