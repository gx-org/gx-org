package main

func onesLike[N int](a [N]float32) [N]float32 {
	return [N]float32(1)
}

func ones[N int]() [N]float32 {
	return [N]float32(1)
}

func zeros[Shape []int]() [Shape...]float32 {
	return [Shape...]float32(0)
}

func Main() ([3]float32, [3]float32, [2][2]float32) {
	a := [3]float32{1, 2, 3}
	// N is inferred from the type of a.
	b := onesLike(a)
	// N does not appear in the parameters of ones: it must be given explicitly.
	c := ones[3]()
	return b, c, zeros[[]int{2, 2}]()
}
