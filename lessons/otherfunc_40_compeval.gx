package main

//gx:compeval
func size(shape []int) int {
	n := 1
	for _, ax := range shape {
		n *= ax
	}
	return n
}

func flatten[S []int](x [S...]float32) [size(S)]float32 {
	return [size(S)]float32(x)
}

//gx:compeval
func checkEven(n int) int {
	require(n%2 == 0, "length %d is not even", n)
	return n
}

func add[N int](x, y [N]float32) [checkEven(N)]float32 {
	return x + y
}

func Main() ([6]float32, [4]float32) {
	x := [4]float32{1, 2, 3, 4}
	return flatten([2][3]float32{{1, 2, 3}, {4, 5, 6}}), add(x, x)
}
