package main

import (
	"math/grad"
	"num"
	"reflect"
)

type Linear struct {
	W [3]float32
	B float32
}

func loss(x [3]float32, predictor, target Linear) float32 {
	prediction := num.VecMul(predictor.W, x) + predictor.B
	want := num.VecMul(target.W, x) + target.B
	err := want - prediction
	return err * err
}

func sgd(params, grads Linear, lr float32) Linear {
	for _, k := range reflect.Leaves[Linear]() {
		params[k] -= lr * grads[k]
	}
	return params
}

func Main() Linear {
	target := Linear{W: [3]float32{2, 3, 4}, B: 2}
	learner := Linear{}
	input := [3]float32{1, 2, 3}
	_, _, backward, _ := grad.Reverse(loss)(input, learner, target)
	g := backward(1)
	return sgd(learner, g, 0.01)
}
