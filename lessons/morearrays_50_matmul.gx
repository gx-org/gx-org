package main

import "num"

func Main() (float32, [2]float32, [2]float32, [2][2]float32) {
	m := [2][3]float32{{1, 2, 3}, {4, 5, 6}}
	n := [3][2]float32{{1, 0}, {0, 1}, {1, 1}}
	v := [3]float32{2, 2, 2}
	dot := num.VecMul(v, v)
	vn := num.VecMatMul(v, n)
	mv := num.MatVecMul(m, v)
	mn := num.MatMul(m, n)
	return dot, vn, mv, mn
}
